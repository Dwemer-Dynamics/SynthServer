{
    "name": "synth/synthserver",
    "description": "Synthserver production PHP dependencies",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-pgsql": "*",
        "doctrine/dbal": "~4.5.0",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7"
    },
    "config": {
        "platform": {
            "php": "8.2.35"
        },
        "allow-plugins": {},
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "11"
    },
    "autoload": {
        "psr-4": {
            "Synth\\Api\\": "api/",
            "Synth\\Api\\V1\\": "api/v1/",
            "Synth\\Api\\V2\\": "api/v2/",
            "Synth\\Core\\Contracts\\": "core/contracts/",
            "Synth\\Core\\Entities\\": "core/entities/",
            "Synth\\Core\\Entities\\Base\\": "core/entities/base/",
            "Synth\\Core\\Entities\\System\\": "core/entities/system/",
            "Synth\\Core\\DbManager\\": "core/dbmanager/",
            "Synth\\Core\\DbManager\\Dao\\": "core/dbmanager/dao/",
            "Synth\\Migrations\\": "core/dbmanager/migrations/",
            "Synth\\Managers\\": "managers/",
            "Synth\\Drivers\\Llm\\": "drivers/llm/",
            "Synth\\Drivers\\Tts\\": "drivers/tts/",
            "Synth\\Drivers\\Stt\\": "drivers/stt/",
            "Synth\\Drivers\\Itt\\": "drivers/itt/",
            "Synth\\Workers\\": "workers/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Synth\\Tests\\": "tests/"
        }
    }
}
